# Copy to .env and edit. All values have working defaults (SQLite + local disk
# + in-memory vector store + deterministic perceptual embedder), so you can run
# the whole platform with NO external services.

# --- Database -------------------------------------------------------------
# ENCOUNTER_DATABASE_URL=postgresql+psycopg://encounter:secret@localhost:5432/encounter

# --- Object storage (Cloudflare R2) --------------------------------------
# ENCOUNTER_STORAGE_BACKEND=r2
# ENCOUNTER_R2_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# ENCOUNTER_R2_ACCESS_KEY_ID=...
# ENCOUNTER_R2_SECRET_ACCESS_KEY=...
# ENCOUNTER_R2_BUCKET=encounter
# ENCOUNTER_STORAGE_PUBLIC_BASE_URL=https://cdn.encounter.app

# --- Embeddings -----------------------------------------------------------
# ENCOUNTER_EMBEDDER_BACKEND=siglip
# ENCOUNTER_SIGLIP_MODEL=google/siglip-base-patch16-224
# ENCOUNTER_EMBEDDING_DIM=768

# --- Vector store (Qdrant) ------------------------------------------------
# ENCOUNTER_VECTOR_BACKEND=qdrant
# ENCOUNTER_QDRANT_URL=http://localhost:6333
# ENCOUNTER_QDRANT_API_KEY=...
# ENCOUNTER_QDRANT_COLLECTION=encounter_images

# --- Reranker (VLM) -------------------------------------------------------
# ENCOUNTER_RERANKER_BACKEND=vlm

# --- Crawler --------------------------------------------------------------
# ENCOUNTER_CRAWL_MAX_PAGES=200
# ENCOUNTER_CRAWL_MAX_IMAGES_PER_PRODUCT=8
